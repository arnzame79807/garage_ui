import { TestBed } from '@angular/core/testing';
import { provideRouter } from '@angular/router';
import { <%= className %>State } from '../../<%= fileName %>.state';
import { ReviewStepComponent } from './review-step.component';

describe('ReviewStepComponent', () => {
  it('submits a complete flow and resets the state', async () => {
    TestBed.configureTestingModule({
      providers: [provideRouter([]), <%= className %>State],
    });
    const state = TestBed.inject(<%= className %>State);
<% steps.forEach(function (s) { %>    state.completeStep('<%= s.key %>', { <%= s.propertyName %>: { example: '<%= s.label %>' } });
<% }) %>
    const fixture = TestBed.createComponent(ReviewStepComponent);
    await fixture.whenStable();
    const el: HTMLElement = fixture.nativeElement;
    expect(el.textContent).toContain('example: <%= steps[0].label %>');

    (el.querySelector('button') as HTMLButtonElement).click();
    await fixture.whenStable();

    expect(el.textContent).toContain('Submitted');
    expect(state.isComplete()).toBe(false);
  });
});
