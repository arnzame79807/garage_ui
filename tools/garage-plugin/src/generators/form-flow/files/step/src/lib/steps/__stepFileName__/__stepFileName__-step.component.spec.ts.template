import { TestBed } from '@angular/core/testing';
import { ActivatedRoute, Router, provideRouter } from '@angular/router';
import { <%= className %>State } from '../../<%= fileName %>.state';
import { <%= step.className %>StepComponent } from './<%= step.fileName %>-step.component';

describe('<%= step.className %>StepComponent', () => {
  async function setup() {
    TestBed.configureTestingModule({
      providers: [provideRouter([]), <%= className %>State],
    });
    const navigate = jest.spyOn(TestBed.inject(Router), 'navigate').mockResolvedValue(true);
    const fixture = TestBed.createComponent(<%= step.className %>StepComponent);
    await fixture.whenStable();
    const el: HTMLElement = fixture.nativeElement;
    const submit = () => {
      (el.querySelector('form') as HTMLFormElement).dispatchEvent(new Event('submit'));
      fixture.detectChanges();
    };
    return { el, navigate, submit, state: TestBed.inject(<%= className %>State) };
  }

  it('requires a value before continuing', async () => {
    const { el, navigate, submit } = await setup();
    submit();
    expect(navigate).not.toHaveBeenCalled();
    expect(el.textContent).toContain('This field is required.');
  });

  it('saves the step and moves to "<%= step.nextPath %>"', async () => {
    const { el, navigate, submit, state } = await setup();
    const input = el.querySelector('input') as HTMLInputElement;
    input.value = 'hello';
    input.dispatchEvent(new Event('input'));
    submit();

    expect(state.data().<%= step.propertyName %>).toEqual({ example: 'hello' });
    expect(state.isStepComplete('<%= step.key %>')).toBe(true);
    expect(navigate).toHaveBeenCalledWith(['..', '<%= step.nextPath %>'], {
      relativeTo: TestBed.inject(ActivatedRoute),
    });
  });
});
