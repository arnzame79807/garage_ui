{
  "name": "@garage/source",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "start": "nx serve garage",
    "start:sandbox": "nx serve sandbox",
    "build": "nx build garage",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint && npm run lint:styles",
    "e2e": "nx run-many -t e2e",
    "affected": "nx affected -t lint test build e2e",
    "g:form-flow": "nx g @garage/plugin:form-flow",
    "lint:styles": "stylelint \"**/*.scss\" --cache --cache-location .nx/cache/stylelint/ --allow-empty-input",
    "format": "nx format:write",
    "prepare": "husky"
  },
  "nx": {
    "includedScripts": []
  },
  "dependencies": {
    "@angular/common": "~20.3.0",
    "@angular/compiler": "~20.3.0",
    "@angular/core": "~20.3.0",
    "@angular/forms": "~20.3.0",
    "@angular/platform-browser": "~20.3.0",
    "@angular/router": "~20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "~20.3.0",
    "@angular-devkit/schematics": "~20.3.0",
    "@angular/build": "~20.3.0",
    "@angular/cli": "~20.3.0",
    "@angular/compiler-cli": "~20.3.0",
    "@angular/language-service": "~20.3.0",
    "@angular/platform-browser-dynamic": "~20.3.0",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "21.6.1",
    "@nx/devkit": "21.6.1",
    "@nx/eslint": "21.6.1",
    "@nx/eslint-plugin": "21.6.1",
    "@nx/jest": "21.6.1",
    "@nx/js": "21.6.1",
    "@nx/playwright": "21.6.1",
    "@nx/plugin": "21.6.1",
    "@nx/web": "21.6.1",
    "@nx/workspace": "21.6.1",
    "@playwright/test": "^1.55.0",
    "@schematics/angular": "~20.3.0",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.0",
    "angular-eslint": "^20.3.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-preset-angular": "~14.6.0",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^17.6.0",
    "nx": "21.6.1",
    "prettier": "^3.6.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0"
  },
  "overrides": {
    "@nx/nx-darwin-arm64": "$nx",
    "@nx/nx-darwin-x64": "$nx",
    "@nx/nx-freebsd-x64": "$nx",
    "@nx/nx-linux-arm-gnueabihf": "$nx",
    "@nx/nx-linux-arm64-gnu": "$nx",
    "@nx/nx-linux-arm64-musl": "$nx",
    "@nx/nx-linux-x64-gnu": "$nx",
    "@nx/nx-linux-x64-musl": "$nx",
    "@nx/nx-win32-arm64-msvc": "$nx",
    "@nx/nx-win32-x64-msvc": "$nx"
