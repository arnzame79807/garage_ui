    "nx@21.6.1": true,
    "@swc/core@1.5.29": true,
    "esbuild@0.25.5": true,
    "esbuild@0.28.1": true,
    "lmdb@3.4.2": true,
    "msgpackr-extract@3.0.6": true,
    "@parcel/watcher@2.6.0": true
  }
}
